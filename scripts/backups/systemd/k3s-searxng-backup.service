# managed by nas-backup-migration
[Unit]
Description=searxng native Valkey, cache, and VolSync backup
Wants=network-online.target
After=network-online.target k3s.service k3s-board-games-backup.service k3s-searxng-backup-recovery.service
Requires=k3s.service k3s-searxng-backup-recovery.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /usr/local/lib/k3s-backups/searxng/current/scripts/backups/daily-searxng.py
ExecStopPost=/usr/bin/python3 -u /usr/local/lib/k3s-backups/searxng/current/scripts/backups/daily-searxng.py --recover-writer-only
TimeoutStartSec=120min
TimeoutStopSec=240
NoNewPrivileges=true
PrivateTmp=true
Nice=10
