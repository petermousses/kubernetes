# managed by nas-backup-migration
[Unit]
Description=resume searxng after interrupted cache backup
After=k3s.service
Requires=k3s.service
Before=k3s-searxng-backup.service
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=true
User=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /usr/local/lib/k3s-backups/searxng/current/scripts/backups/daily-searxng.py --recover-writer-only
TimeoutStartSec=5min
Restart=on-failure
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
