# managed by nas-backup-migration
[Unit]
Description=recover the authoritative GPT writer after interrupted storage cutover
After=k3s.service
Requires=k3s.service
Before=k3s-paperless-gpt-storage-migration.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /usr/local/lib/k3s-backups/paperless-gpt-storage/current/scripts/backups/migrate-paperless-gpt-storage.py --recover
TimeoutStartSec=10min
Restart=on-failure
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
